# Postgres connection. sslmode=verify-full is enough for node-postgres; do not
# add sslrootcert=system here, that's a libpq-only value and pg will try to
# read a literal file named "system" and fail.
DATABASE_URL=postgres://website:PASSWORD@db.w3hc.org:5432/website?sslmode=verify-full

# Long random secret the caller must send as: Authorization: Bearer <token>
# Generate one with: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Bind address/port. Keep HOST at 127.0.0.1 in production: only the reverse
# proxy should be reachable from outside, this process never should be.
HOST=127.0.0.1
PORT=3939

# Comma-separated hostnames the reverse proxy is allowed to forward as `Host`.
# Add your public hostname here if your proxy forwards the original Host
# header (e.g. "proxy_set_header Host $host;" in nginx).
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
